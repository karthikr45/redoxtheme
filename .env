# MongoDB Atlas Connection (Free Tier)
# 1. Sign up at https://www.mongodb.com/cloud/atlas
# 2. Create a free M0 cluster
# 3. Create a database user (username + password)
# 4. Get your connection string and paste below
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/redox-cms?retryWrites=true&w=majority

# Payload CMS Secret (change this to any random string, at least 32 characters)
PAYLOAD_SECRET=change-this-to-a-random-secret-string-at-least-32-chars

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000
